# Existing PostgreSQL database. The platform creates and uses the ontology_platform schema.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/ontology

# 32-byte key encoded in base64. Generate with: openssl rand -base64 32
TARGET_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# At least 32 random characters used to sign session cookies.
AUTH_SECRET=replace-with-a-long-random-secret

# Used once during first setup to create the first administrator.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# Optional. Defaults to <project>/.data/ontology-versions.
ONTOLOGY_VERSION_DIR=D:/ontology-data/versions

# Optional. Oracle Instant Client directory, only needed for Oracle data sources on older servers
# (11g and earlier cannot be reached in the driver's Thin mode). Also accepted: <project>/.data/oracle-client.
ORACLE_CLIENT_LIB_DIR=D:/Program Files/instantclient/instantclient_23_0
# Optional. OpenAI-compatible chat endpoint used by the reasoning workspace.
# Without it the /api/reasoning endpoints report that the model is not configured.
LLM_BASE_URL=https://your-endpoint/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=your-model-name
